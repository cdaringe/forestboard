#!/usr/bin/env python3
"""Send a monochrome image to forestboard over HID feature reports."""
import argparse
from enum import IntEnum
import os
import math
import struct
import sys
import time


PROTOCOL_VERSION = 1
PAYLOAD_CAPACITY = 56
FRAME_SIZE = 2048


class Opcode(IntEnum):
    BEGIN_FRAME = 1
    WRITE_PIXELS = 2
    PRESENT_FRAME = 3
    RELEASE_DISPLAY = 4


def packet(opcode, frame_id=0, offset=0, data=b""):
    if len(data) > PAYLOAD_CAPACITY:
        raise ValueError("Packet payload exceeds 56 bytes")
    return struct.pack("<BBHHBB", PROTOCOL_VERSION, opcode, frame_id, offset, len(data), 0) + data.ljust(PAYLOAD_CAPACITY, b"\0")


def status(device):
    reply = bytes(device.get_feature_report(0, 65))
    # HIDAPI backends can retain the synthetic zero report-ID byte.
    if reply[:1] == b"\0":
        reply = reply[1:]
    if len(reply) < 5 or reply[:3] != b"FB\x01":
        raise RuntimeError("Device does not support forestboard display protocol v1")
    return reply[3], reply[4]


def wait_ready(device, check_result=True):
    deadline = time.monotonic() + 3
    while time.monotonic() < deadline:
        busy, result = status(device)
        if not busy:
            if check_result and result:
                raise RuntimeError("Firmware rejected display packet")
            return
        time.sleep(0.002)
    raise TimeoutError("Keyboard did not process display packet within 3 seconds")


def send(device, message):
    # HIDAPI requires a leading zero for an unnumbered report.
    if device.send_feature_report(b"\0" + message) not in (64, 65):
        raise RuntimeError("Incomplete HID feature write")
    wait_ready(device)


def send_frame(device, pixels, frame_id):
    if len(pixels) != FRAME_SIZE:
        raise ValueError("Expected a 128 x 128 one-bit frame")
    send(device, packet(Opcode.BEGIN_FRAME, frame_id))
    for offset in range(0, len(pixels), PAYLOAD_CAPACITY):
        send(device, packet(Opcode.WRITE_PIXELS, frame_id, offset, pixels[offset:offset + PAYLOAD_CAPACITY]))
    send(device, packet(Opcode.PRESENT_FRAME, frame_id))


def convert_image(path, invert=False, dither=True):
    from PIL import Image, ImageOps
    with Image.open(path) as source:
        rgba = source.convert("RGBA")
        background = Image.new("RGBA", rgba.size, "black")
        background.alpha_composite(rgba)
        fitted = ImageOps.contain(background.convert("L"), (128, 128))
        canvas = Image.new("L", (128, 128), 0)
        canvas.paste(fitted, ((128 - fitted.width) // 2, (128 - fitted.height) // 2))
        if invert:
            canvas = ImageOps.invert(canvas)
        mode = Image.Dither.FLOYDSTEINBERG if dither else Image.Dither.NONE
        return canvas.convert("1", dither=mode).tobytes()


def open_device(hid, path):
    if path:
        paths = [os.fsencode(path)]
    else:
        candidates = [d for d in hid.enumerate()
                      if d.get("product_string") == "forestboard"
                      and (d.get("usage_page") == 0xFF00 or d.get("interface_number") == 0)]
        # Windows exposes collections separately; prefer the vendor collection.
        vendor = [d for d in candidates if d.get("usage_page") == 0xFF00]
        paths = list(dict.fromkeys(d["path"] for d in (vendor or candidates)))
    if len(paths) != 1:
        raise RuntimeError("Expected one forestboard display interface; use --list and --path")
    device = hid.device()
    try:
        device.open_path(paths[0])
        wait_ready(device, check_result=False)
    except Exception:
        device.close()
        raise
    return device



def positive_seconds(value):
    seconds = float(value)
    if not math.isfinite(seconds) or seconds <= 0:
        raise argparse.ArgumentTypeError("duration must be positive and finite")
    return seconds


def benchmark(device, duration):
    from PIL import Image, ImageDraw
    started = time.monotonic()
    latencies = []
    while time.monotonic() - started < duration:
        frame_id = len(latencies)
        canvas = Image.new("1", (128, 128))
        draw = ImageDraw.Draw(canvas)
        draw.rectangle((0, 0, 127, 127), outline=1)
        draw.text((8, 12), "HOST FPS TEST", fill=1)
        draw.text((8, 32), f"FRAME {frame_id}", fill=1)
        x = 4 + (frame_id * 3) % 104
        draw.rectangle((x, 66, x + 15, 81), fill=1)
        draw.text((8, 104), "USB -> OLED", fill=1)
        before = time.monotonic()
        send_frame(device, canvas.tobytes(), frame_id % 65536)
        latencies.append(time.monotonic() - before)
    elapsed = time.monotonic() - started
    if latencies:
        average_ms = sum(latencies) / len(latencies) * 1000
        print(f"Accepted {len(latencies)} frames in {elapsed:.2f}s: "
              f"{len(latencies) / elapsed:.2f} fps; "
              f"mean transfer {average_ms:.1f} ms, "
              f"max {max(latencies) * 1000:.1f} ms.")
    send(device, packet(Opcode.RELEASE_DISPLAY))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("image", nargs="?")
    parser.add_argument("--list", action="store_true", help="List forestboard HID paths")
    parser.add_argument("--path", help="Select a HID device path")
    parser.add_argument("--once", action="store_true", help="Send once; firmware expires it after 5 seconds")
    parser.add_argument("--benchmark", type=positive_seconds, metavar="SECONDS",
                        help="Measure accepted frame rate with a moving test pattern")
    parser.add_argument("--invert", action="store_true")
    parser.add_argument("--no-dither", action="store_true")
    args = parser.parse_args()
    try:
        import hid
        if args.list:
            for info in hid.enumerate():
                if info.get("product_string") == "forestboard":
                    print(os.fsdecode(info["path"]), "interface=", info.get("interface_number"),
                          "usage_page=", hex(info.get("usage_page", 0)))
            return 0
        if not args.image and args.benchmark is None:
            parser.error("provide an image, --benchmark SECONDS, or --list")
        pixels = (convert_image(args.image, args.invert, not args.no_dither)
                  if args.benchmark is None else None)
        device = open_device(hid, args.path)
        try:
            if args.benchmark is not None:
                benchmark(device, args.benchmark)
                return 0
            frame_id = 0
            while True:
                send_frame(device, pixels, frame_id)
                if args.once:
                    break
                if frame_id == 0:
                    print("Image displayed; Ctrl-C restores local animations.", flush=True)
                time.sleep(2)
                frame_id = (frame_id + 1) & 0xFFFF
        except KeyboardInterrupt:
            wait_ready(device, check_result=False)
            send(device, packet(Opcode.RELEASE_DISPLAY))
        finally:
            device.close()
        return 0
    except (ImportError, OSError, RuntimeError, ValueError) as error:
        print(f"forestboard-display: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
